{
  "name": "coolstuff",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A free, interactive, visual-first textbook for university STEM and CS.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/build-index.ts && vite",
    "build": "tsx scripts/build-index.ts && vite build",
    "preview": "vite preview",
    "index": "tsx scripts/build-index.ts",
    "new": "tsx scripts/new-lesson.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "progress:sync": "tsx scripts/build-index.ts && tsx scripts/sync-progress.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/d3": "7.4.3",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@preact/signals": "2.11.3",
    "d3": "7.9.0",
    "katex": "0.18.11",
    "marked": "18.1.1",
    "preact": "10.29.8",
    "three": "0.186.1"
  }
}
