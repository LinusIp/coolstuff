{
  "name": "coolstuff",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A lab and showcase of finished, ambitious little projects.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/build-index.ts && vite",
    "build": "tsx scripts/build-index.ts && vite build",
    "preview": "vite preview",
    "index": "tsx scripts/build-index.ts",
    "new": "tsx scripts/new-project.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.1",
    "lil-gui": "0.21.0",
    "marked": "18.1.1"
  }
}
